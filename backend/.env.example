# ─────────────────────────────────────────────
#  KENYAPAY PLATFORM — ENVIRONMENT CONFIGURATION
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/kenyapay_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256 for storing sensitive API credentials)
ENCRYPTION_KEY=your_32_character_encryption_key_here!

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
#  M-PESA (SAFARICOM DARAJA API)
# ─────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=174379
MPESA_B2C_SHORTCODE=600000
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_ENVIRONMENT=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/webhooks/mpesa

# ─────────────────────────────────────────────
#  PESALINK (Interbank Transfers)
# ─────────────────────────────────────────────
PESALINK_CLIENT_ID=your_pesalink_client_id
PESALINK_CLIENT_SECRET=your_pesalink_client_secret
PESALINK_BASE_URL=https://api.pesalink.co.ke
PESALINK_CALLBACK_URL=https://yourdomain.com/api/v1/webhooks/pesalink

# ─────────────────────────────────────────────
#  EQUITY JENGA API (Bank Transfers)
# ─────────────────────────────────────────────
JENGA_API_KEY=your_jenga_api_key
JENGA_MERCHANT_CODE=your_merchant_code
JENGA_CONSUMER_SECRET=your_jenga_secret
JENGA_BASE_URL=https://uat.jengahq.io
JENGA_CALLBACK_URL=https://yourdomain.com/api/v1/webhooks/jenga

# ─────────────────────────────────────────────
#  KCB OPEN BANKING (Bank Transfers)
# ─────────────────────────────────────────────
KCB_CLIENT_ID=your_kcb_client_id
KCB_CLIENT_SECRET=your_kcb_client_secret
KCB_BASE_URL=https://openapi.kcbgroup.com
KCB_CALLBACK_URL=https://yourdomain.com/api/v1/webhooks/kcb

# ─────────────────────────────────────────────
#  EMAIL (Notifications)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="KenyaPay Platform <noreply@kenyapay.co.ke>"

# ─────────────────────────────────────────────
#  AFRICAS TALKING (SMS Notifications)
# ─────────────────────────────────────────────
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=KENYAPAY

# System
SUPER_ADMIN_EMAIL=superadmin@kenyapay.co.ke
SUPER_ADMIN_PASSWORD=SuperAdmin@2024!
PLATFORM_NAME=KenyaPay Platform
PLATFORM_VERSION=1.0.0

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=./uploads

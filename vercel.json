{
  "version": 2,
  "framework": null,
  "buildCommand": "cd frontend && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd backend && npm install --legacy-peer-deps",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node",
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index.ts" },
    { "source": "/health",         "destination": "/api/index.ts" },
    { "source": "/((?!api).*)",    "destination": "/index.html" }
  ]
}

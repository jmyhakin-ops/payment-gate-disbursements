{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index.ts" },
    { "source": "/health",        "destination": "/api/index.ts" },
    { "source": "/(.*)",          "destination": "/index.html" }
  ]
}

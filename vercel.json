{
  "version": 2,
  "buildCommand": "cd frontend && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd backend && npm install --legacy-peer-deps",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "backend/src/**,backend/prisma/**,backend/package.json,backend/tsconfig.json"
    }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index.ts" },
    { "source": "/health",        "destination": "/api/index.ts" },
    { "source": "/(.*)",          "destination": "/index.html" }
  ]
}
